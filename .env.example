# Environment Variables for Finbaba

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# JWT Secret (Change this to a random secure string)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (Create these in your Stripe Dashboard)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly_id
STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly_id
STRIPE_PRICE_BUSINESS_MONTHLY=price_business_monthly_id
STRIPE_PRICE_BUSINESS_YEARLY=price_business_yearly_id

# Database (Optional - for future use)
# DATABASE_URL=mongodb://localhost:27017/finbaba
# POSTGRES_URL=postgresql://user:password@localhost:5432/finbaba

# Email Service (Optional - for future use)
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_FROM=noreply@finbaba.com

# Redis (Optional - for caching)
# REDIS_URL=redis://localhost:6379
